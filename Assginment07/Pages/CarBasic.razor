@page "/car-basic"

<div class="container mt-5">

    <h2 class="text-center mb-4">Change Color Car</h2>

    <div class="text-center mb-4">

        <img src="@currentCar.Image" width="500" />

        <h4 class="mt-3">
            @currentCar.Name
        </h4>
    </div>

    <div class="text-center">
        @foreach (var color in carColors)
        {
            <button class="btn @color.ButtonClass me-2" @onclick="() => ChangeColor(color)">
                @color.Name
            </button>
        }
    </div>

</div>

@code {


    @* private List<string> carColors = new()
    {
        "black",
        "red",
        "silver",
        "steel"
    }; *@
    public List<CarColor> carColors = new(){
        new CarColor("Black","/CarBasic/products/black-car.jpg","btn-dark"),
        new CarColor("Red","/CarBasic/products/red-car.jpg","btn-danger"),
        new CarColor("Silver","/CarBasic/products/silver-car.jpg","btn-secondary"),
        new CarColor("Steel","/CarBasic/products/steel-car.jpg","btn-primary")
    };
    protected override void OnInitialized()
    {
        currentCar = carColors[0];
    }

    @* private void ChangeColor(string color)
    {
        currentImage = $"/CarBasic/products/{color}-car.jpg";
    } *@
    private void ChangeColor(CarColor color)
    {
        currentCar = color;
    }
    private CarColor currentCar;

}